_Transporte : \&quot;Ladung_Adress\&quot;\n    tAdressen ||--o{ tVeranstaltungen_Messe_Transporte : \&quot;Notify_Adress\&quot;\n    tAdressen ||--o{ tVeranstaltungen_Messe_Transporte : \&quot;Spedition_Adress\&quot;\n    tVeranstaltungen_Messe_Transporte }o--o| tVeranstaltungen_Messe_Transporte : \&quot;verknuepft_Haupt_MTransport\&quot;\n    tVeranstaltungen_Messe_Transporte }o--o| tVeranstaltungen_Messe_Transporte : \&quot;verknuepft_Unter_MTransport\&quot;\n\n    tMesse_Bauteile {\n        int Bauteil_ID PK\n        link Bauteil_Herkunft_Position_IDV FK\n        link Bauteil_Duplikat_Bauteil_IDV FK\n        link Bauteil_Uminventarisierung_Bauteil_IDV FK\n    }\n\n    tMesse_Cases {\n        int Case_ID PK\n        link Case_CaseGesperrt_IDV FK\n        link Case_Uminventarisierung_Case_IDV FK\n    }\n\n    tMesse_CaseTypen {\n        int CT_ID PK\n        link CT_Katalog_IDV FK\n        link CT_Duplikat_CT_IDV FK\n        link CT_Uminventarisierung_CT_IDV FK\n    }\n\n    tMesse_CaseInhalt {\n        int CaseInhalt_ID PK\n        link CaseInhalt_Bauteil_IDV FK\n    }\n\n    tVeranstaltungen_Messe_Colli {\n        int MColli_ID PK\n        link MColli_Lieferung_MTransport_IDV FK\n    }\n\n    tVeranstaltungen_Messe_Transporte {\n        int MTransport_ID PK\n        link MTransport_Spedition_Adress_IDV FK\n        link MTransport_Ladung_Adress_IDV FK\n        link MTransport_Entladung_Adress_IDV FK\n        link MTransport_Notify_Adress_IDV FK\n        link MTransport_verknuepft_Haupt_MTransport_IDV FK\n        link MTransport_verknuepft_Unter_MTransport_IDV FK\n        link MTransport_Fahrzeug_IDV FK\n    }\n\n    tVeranstaltungen_Messe_Cases {\n        int MCase_ID PK\n        link MCase_Lieferung_MTransport_IDV FK\n    }\n\n    %% === RECHNUNGEN &amp; FINANZEN ===\n    tAdressen ||--o{ tEingangsrechnungen : \&quot;von_Adress\&quot;\n    tAdressen ||--o{ tRechnungen : \&quot;Adress\&quot;\n\n    tRechnungen {\n        int Rechnung_ID PK\n        link RKunde_Adr