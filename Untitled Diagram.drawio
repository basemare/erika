        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;dark\&quot;, \&quot;themeVariables\&quot;: {\&quot;primaryColor\&quot;: \&quot;#000000\&quot;, \&quot;primaryTextColor\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryBorderColor\&quot;: \&quot;#ffffff\&quot;, \&quot;lineColor\&quot;: \&quot;#ffffff\&quot;, \&quot;secondaryColor\&quot;: \&quot;#000000\&quot;, \&quot;tertiaryColor\&quot;: \&quot;#000000\&quot;, \&quot;background\&quot;: \&quot;#000000\&quot;, \&quot;mainBkg\&quot;: \&quot;#000000\&quot;, \&quot;nodeBorder\&quot;: \&quot;#ffffff\&quot;, \&quot;clusterBkg\&quot;: \&quot;#000000\&quot;, \&quot;titleColor\&quot;: \&quot;#ffffff\&quot;, \&quot;edgeLabelBackground\&quot;: \&quot;#000000\&quot;, \&quot;attributeBackgroundColorEven\&quot;: \&quot;#000000\&quot;, \&quot;attributeBackgroundColorOdd\&quot;: \&quot;#000000\&quot;}}}%%\nerDiagram\n    %% ============================================\n    %% METROS - ERD Essential (nur Schlüssel)\n    %% ============================================\n\n    %% === POSITIONEN (Projekte) ===\n    tAdressen ||--o{ tPositionen : \&quot;Adress\&quot;\n\n    tPositionen {\n        int PositionsID PK\n        link PProjektleiter_Adress_IDV FK\n        link PProjektMeister_Adress_IDV FK\n        link PProjektLogistiker_Adress_IDV FK\n        link PKunde_Adress_IDV FK\n        link Pcc_Adress_IDV FK\n        link PFin_Konto_IDV FK\n    }\n\n    %% === ADRESSEN &amp; KONTAKTE ===\n    tAnreden ||--o{ tAdressen : \&quot;Anrede\&quot;\n    tAdressen }o--o| tAdressen : \&quot;Mitarbeiter_vonSub_Adress\&quot;\n    tAdressen }o--o| tAdressen : \&quot;verantwortlich_Adress\&quot;\n    tAdressen ||--o{ tAnsprechpartner : \&quot;Adress\&quot;\n    tAnreden ||--o{ tAnsprechpartner : \&quot;Anrede\&quot;\n\n    tAdressen {\n        int Adress_ID PK\n        link AStatus_Mitarbeiter_vonSub_Adress_IDV FK\n        link AEinzelperson_Anrede_IDV FK\n        link AMitarbeiterPlanstelle_MPS_IDV FK\n        link AVertrieb_verantwortlich_Adress_IDV FK\n    }\n\n    tAnsprechpartner {\n        int Ansprech_ID PK\n        link Ansprech_Adress_IDV FK\n        link Ansprech_Anrede_IDV FK\n    }\n\n    %% === ASP FERTIGUNG ===\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;Konstruktion_Adress\&quot;\n    tPositionen ||--o{ tASP_Eigenfertigung : \&quot;Position\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;UebergabeAn_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;UebergabeAn_HIN_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;anAV_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;anWM_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;an_Adress\&quot;\n    tASP_Eigenfertigung }o--o| tASP_Eigenfertigung : \&quot;aus_EF\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;geprueft_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;pruefen_Adress\&quot;\n    tAdressen ||--o{ tASP_Eigenfertigung : \&quot;von_Adress\&quot;\n    tAdressen ||--o{ tASP_Einkauf : \&quot;Bearbeiter_Adress\&quot;\n    tAdressen ||--o{ tASP_Einkauf : \&quot;Lieferung_an_Adress\&quot;\n    tPositionen ||--o{ tASP_Einkauf : \&quot;Position\&quot;\n    tASP_Einkauf ||--o{ tASP_Fremdfertigung : \&quot;Einkauf\&quot;\n    tASP_Zeichnungen ||--o{ tASP_Fremdfertigung : \&quot;Einkauf_ZE\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;Konstruktion_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;Lieferanschrift_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;Lieferant_Adress\&quot;\n    tPositionen ||--o{ tASP_Fremdfertigung : \&quot;Position\&quot;\n    tASP_Fremdfertigung }o--o| tASP_Fremdfertigung : \&quot;Sammelauftrag_FF\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;UebergabeAn_Adress\&quot;\n    tASP_Zeichnungen ||--o{ tASP_Fremdfertigung : \&quot;ZE\&quot;\n    tASP_Eigenfertigung ||--o{ tASP_Fremdfertigung : \&quot;aus_EF\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;geprueft_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;pruefen_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;verhandelt_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;vonRueckfragen_Adress\&quot;\n    tAdressen ||--o{ tASP_Fremdfertigung : \&quot;von_Adress\&quot;\n    tASP_Einkauf ||--o{ tASP_Materialbestellungen : \&quot;Einkauf\&quot;\n    tASP_Zeichnungen ||--o{ tASP_Materialbestellungen : \&quot;Einkauf_ZE\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;Lieferanschrift_Adress\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;Lieferant_Adress\&quot;\n    tPositionen ||--o{ tASP_Materialbestellungen : \&quot;Position\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;UebergabeAn_Adress\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;geprueft_Adress\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;pruefen_Adress\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;verhandelt_Adress\&quot;\n    tAdressen ||--o{ tASP_Materialbestellungen : \&quot;von_Adress\&quot;\n    tAdressen ||--o{ tASP_Zeichnungen : \&quot;Einkauf_Bearbeiter_Adress\&quot;\n    tAdressen ||--o{ tASP_Zeichnungen : \&quot;Einkauf_Lieferung_an_Adress\&quot;\n    tAdressen ||--o{ tASP_Zeichnungen : \&quot;Meister_Adress\&quot;\n    tPositionen ||--o{ tASP_Zeichnungen : \&quot;Position\&quot;\n    tMesse_Bauteile ||--o{ tASP_Zeichnungen : \&quot;inBauteil_Bauteil\&quot;\n    tASP_Zeichnungen }o--o| tASP_Zeichnungen : \&quot;kopiertvon_ZE\&quot;\n    tMesse_Bauteile ||--o{ tASP_Zeichnungen : \&quot;vonBauteil_Bauteil\&quot;\n\n    tASP_Fremdfertigung {\n        int FF_ID PK\n        link FF_Position_IDV FK\n        link FF_ZE_IDV FK\n        link FF_LiefKatLeistung_IDV FK\n        link FF_Lieferant_Adress_IDV FK\n        link FF_Lieferanschrift_Adress_IDV FK\n        link FF_Lieferanschrift_UebergabeAn_AMG_IDV FK\n        link FF_von_Adress_IDV FK\n        link FF_vonRueckfragen_Adress_IDV FK\n        link FF_Abstellort_IDV FK\n        link FF_pruefen_Adress_IDV FK\n        link FF_geprueft_Adress_IDV FK\n        link FF_UebergabeAn_Adress_IDV FK\n        link FF_Sammelauftrag_FF_IDV FK\n        link FF_Konstruktion_Adress_IDV FK\n        link FF_Einkauf_IDV FK\n        link FF_Einkauf_ZE_IDV FK\n        link FF_aus_EF_IDV FK\n        link FF_verhandelt_Adress_IDV FK\n        link FF_AuftragImport_IDV FK\n    }\n\n    tASP_Eigenfertigung {\n        int EF_ID PK\n        link EF_Position_IDV FK\n        link EF_an_Adress_IDV FK\n        link EF_von_Adress_IDV FK\n        link EF_Konstruktion_Adress_IDV FK\n        link EF_anAV_Adress_IDV FK\n        link EF_anWM_Adress_IDV FK\n        link EF_pruefen_Adress_IDV FK\n        link EF_geprueft_Adress_IDV FK\n        link EF_Abstellort_IDV FK\n        link EF_UebergabeAn_Adress_IDV FK\n        link EF_UebergabeAn_HIN_Adress_IDV FK\n        link EF_UebergabeAn_HIN_Abstellort_IDV FK\n        link EF_aus_EF_IDV FK\n    }\n\n    tASP_Zeichnungen {\n        int ZE_ID PK\n        link ZE_Position_IDV FK\n        link ZE_Meister_Adress_IDV FK\n        link ZE_LVPos_VLVPos_IDV FK\n        link ZE_inBauteil_Bauteil_IDV FK\n        link ZE_kopiertvon_ZE_IDV FK\n        link ZE_vonBauteil_Bauteil_IDV FK\n        link ZE_Einkauf_Lieferung_an_Adress_IDV FK\n        link ZE_Einkauf_Lieferung_an_UebergabeAn_AMG_IDV FK\n        link ZE_Einkauf_Bearbeiter_Adress_IDV FK\n        link ZE_AuftragImportPos_IDV FK\n        link ZE_ZEImpPos_IDV FK\n    }\n\n    tASP_Materialbestellungen {\n        int MB_ID PK\n        link MB_Position_IDV FK\n        link MB_Lieferant_Adress_IDV FK\n        link MB_Lieferanschrift_Adress_IDV FK\n        link MB_Lieferanschrift_UebergabeAn_AMG_IDV FK\n        link MB_von_Adress_IDV FK\n        link MB_Abstellort_IDV FK\n        link MB_pruefen_Adress_IDV FK\n        link MB_geprueft_Adress_IDV FK\n        link MB_Ueberga